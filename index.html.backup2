<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>頝單?? - 靽桀儔??/title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Arial', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .game-container {
            background: white;
            border-radius: 15px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            padding: 30px;
            max-width: 700px;
            width: 90%;
            max-height: 95vh;
            overflow-y: auto;
        }

        /* ??隞璅?? */
        .start-screen {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            min-height: 400px;
        }

        .start-screen h1 {
            font-size: 48px;
            color: #333;
            margin-bottom: 40px;
            text-align: center;
        }

        .start-screen p {
            font-size: 18px;
            color: #666;
            margin-bottom: 30px;
            text-align: center;
        }

        .mode-buttons {
            display: flex;
            flex-direction: column;
            gap: 20px;
            width: 100%;
        }

        .mode-btn {
            padding: 20px;
            font-size: 18px;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s;
            font-weight: bold;
            color: white;
            text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.2);
        }

        .mode-btn.ai {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .mode-btn.ai:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(102, 126, 234, 0.4);
        }

        .mode-btn.pvp {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        }

        .mode-btn.pvp:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(245, 87, 108, 0.4);
        }

        .mode-btn.online {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        }

        .mode-btn.online:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(79, 172, 254, 0.4);
        }

        .mode-btn.rules {
            background: linear-gradient(135deg, #84fab0 0%, #8fd3f4 100%);
        }

        .mode-btn.rules:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(132, 250, 176, 0.4);
        }

        .mode-btn-icon {
            font-size: 24px;
            margin-right: 10px;
        }

        /* ?輸?閮剖?隞 */
        .room-setup-screen {
            display: none;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            min-height: 400px;
        }

        .room-setup-screen h2 {
            font-size: 32px;
            color: #333;
            margin-bottom: 30px;
            text-align: center;
        }

        .room-setup-group {
            display: flex;
            flex-direction: column;
            gap: 20px;
            width: 100%;
        }

        .room-setup-item {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .room-setup-item label {
            font-size: 14px;
            color: #666;
            font-weight: bold;
        }

        .room-setup-item input,
        .room-setup-item select {
            padding: 12px;
            font-size: 16px;
            border: 2px solid #ddd;
            border-radius: 8px;
            transition: all 0.3s;
        }

        .room-setup-item input:focus,
        .room-setup-item select:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

        .room-setup-item input::placeholder {
            color: #bbb;
        }

        .game-mode-selection {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-top: 10px;
        }

        .game-mode-option {
            padding: 12px;
            border: 2px solid #ddd;
            border-radius: 8px;
            cursor: pointer;
            text-align: center;
            transition: all 0.3s;
            background: white;
            font-weight: bold;
            color: #333;
        }

        .game-mode-option:hover {
            border-color: #667eea;
            background: rgba(102, 126, 234, 0.1);
        }

        .game-mode-option.selected {
            background: #667eea;
            border-color: #667eea;
            color: white;
        }

        .timer-toggle {
            display: flex;
            align-items: center;
            gap: 15px;
            margin: 15px 0;
            padding: 15px;
            background: #f5f5f5;
            border-radius: 8px;
        }

        .timer-toggle label {
            flex: 1;
            font-size: 16px;
            color: #333;
            font-weight: bold;
            cursor: pointer;
        }

        .checkbox {
            position: relative;
            display: inline-block;
            width: 24px;
            height: 24px;
            cursor: pointer;
        }

        .checkbox input {
            opacity: 0;
            width: 0;
            height: 0;
        }

        .checkbox-checkmark {
            position: absolute;
            top: 0;
            left: 0;
            height: 24px;
            width: 24px;
            background-color: #eee;
            border: 2px solid #ccc;
            border-radius: 4px;
            transition: all 0.3s;
        }

        .checkbox:hover input ~ .checkbox-checkmark {
            background-color: #f0f0f0;
            border-color: #667eea;
        }

        .checkbox input:checked ~ .checkbox-checkmark {
            background-color: #667eea;
            border-color: #667eea;
        }

        .checkbox-checkmark:after {
            content: "";
            position: absolute;
            display: none;
            left: 7px;
            top: 3px;
            width: 6px;
            height: 12px;
            border: solid white;
            border-width: 0 2px 2px 0;
            transform: rotate(45deg);
        }

        .checkbox input:checked ~ .checkbox-checkmark:after {
            display: block;
        }

        .room-setup-buttons {
            display: flex;
            gap: 10px;
            margin-top: 20px;
            width: 100%;
        }

        .room-setup-buttons button {
            flex: 1;
            padding: 12px;
            font-size: 16px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s;
        }

        .btn-start {
            background: #667eea;
            color: white;
        }

        .btn-start:hover {
            background: #5568d3;
            transform: translateY(-2px);
        }

        .btn-back {
            background: #ccc;
            color: #333;
        }

        .btn-back:hover {
            background: #bbb;
            transform: translateY(-2px);
        }

        /* 閬?隞 */
        .rules-screen {
            display: none;
            flex-direction: column;
            min-height: 400px;
        }

        .rules-screen h2 {
            font-size: 32px;
            color: #333;
            margin-bottom: 20px;
            text-align: center;
        }

        .rules-content {
            background: #f9f9f9;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 20px;
            max-height: 400px;
            overflow-y: auto;
            flex: 1;
        }

        .rules-content h3 {
            color: #333;
            margin-top: 15px;
            margin-bottom: 10px;
            font-size: 16px;
        }

        .rules-content h3:first-child {
            margin-top: 0;
        }

        .rules-content ul {
            margin-left: 20px;
            margin-bottom: 10px;
        }

        .rules-content li {
            margin-bottom: 8px;
            line-height: 1.5;
            color: #555;
        }

        .rules-buttons {
            display: flex;
            gap: 10px;
            width: 100%;
        }

        .rules-buttons button {
            flex: 1;
            padding: 12px;
            font-size: 16px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s;
        }

        .btn-back-rules {
            background: #667eea;
            color: white;
        }

        .btn-back-rules:hover {
            background: #5568d3;
            transform: translateY(-2px);
        }

        /* 蝺?璅∪?蝑?隞 */
        .online-wait-screen {
            display: none;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            min-height: 400px;
        }

        .online-wait-screen h2 {
            font-size: 32px;
            color: #333;
            margin-bottom: 30px;
            text-align: center;
        }

        .room-info {
            background: #f5f5f5;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 30px;
            width: 100%;
        }

        .room-info-item {
            display: flex;
            justify-content: space-between;
            margin-bottom: 15px;
            font-size: 16px;
            color: #333;
        }

        .room-info-item:last-child {
            margin-bottom: 0;
        }

        .room-info-label {
            font-weight: bold;
            color: #666;
        }

        .room-id {
            background: #e8f5e9;
            padding: 8px 12px;
            border-radius: 6px;
            font-family: monospace;
            font-size: 14px;
            color: #2e7d32;
            cursor: pointer;
            transition: all 0.3s;
        }

        .room-id:hover {
            background: #c8e6c9;
        }

        .copy-hint {
            font-size: 12px;
            color: #999;
            margin-top: 5px;
        }

        .player-list {
            margin-bottom: 30px;
            width: 100%;
        }

        .player-list h3 {
            color: #333;
            margin-bottom: 15px;
            font-size: 18px;
        }

        .player-item {
            display: flex;
            align-items: center;
            padding: 12px;
            background: #f9f9f9;
            border-radius: 8px;
            margin-bottom: 10px;
            border-left: 4px solid #667eea;
        }

        .player-item.p2 {
            border-left-color: #f093fb;
        }

        .player-status {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            margin-right: 12px;
            background: #ffc107;
        }

        .player-status.online {
            background: #4caf50;
        }

        .player-name {
            flex: 1;
            font-weight: bold;
            color: #333;
        }

        .player-id {
            font-size: 12px;
            color: #999;
            font-family: monospace;
        }

        .waiting-spinner {
            display: flex;
            gap: 5px;
            justify-content: center;
            margin-bottom: 30px;
        }

        .spinner-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #667eea;
            animation: bounce 1.4s infinite;
        }

        .spinner-dot:nth-child(2) {
            animation-delay: 0.2s;
        }

        .spinner-dot:nth-child(3) {
            animation-delay: 0.4s;
        }

        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }

        .waiting-text {
            text-align: center;
            color: #666;
            margin-bottom: 30px;
            font-size: 16px;
        }

        .online-buttons {
            display: flex;
            gap: 10px;
            width: 100%;
            flex-direction: column;
        }

        .online-buttons button {
            padding: 12px;
            font-size: 16px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s;
        }

        .btn-share {
            background: #4facfe;
            color: white;
        }

        .btn-share:hover {
            background: #3fa3ee;
            transform: translateY(-2px);
        }

        .btn-leave {
            background: #ccc;
            color: #333;
        }

        .btn-leave:hover {
            background: #bbb;
            transform: translateY(-2px);
        }

        /* ?隞璅?? */
        .game-screen {
            display: none;
        }

        h1 {
            text-align: center;
            color: #333;
            margin-bottom: 20px;
            font-size: 28px;
        }

        .info-panel {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 15px;
            margin-bottom: 20px;
            padding: 15px;
            background: #f5f5f5;
            border-radius: 10px;
        }

        .info-item {
            text-align: center;
        }

        .info-item.player-name-info {
            text-align: left;
            font-size: 12px;
        }

        .info-label {
            font-size: 12px;
            color: #666;
            text-transform: uppercase;
            margin-bottom: 5px;
        }

        .info-value {
            font-size: 18px;
            font-weight: bold;
            color: #333;
        }

        .player-name-display {
            font-size: 14px;
            color: #333;
            font-weight: bold;
            margin-bottom: 5px;
            padding: 4px 8px;
            border-radius: 4px;
        }

        .player1-info {
            color: #ff6b6b;
            background: rgba(255, 107, 107, 0.1);
        }

        .player2-info {
            color: #4ecdc4;
            background: rgba(78, 205, 196, 0.1);
        }

        .pvp-p2-info {
            color: #9c27b0;
            background: rgba(156, 39, 176, 0.1);
        }

        .timer-display {
            font-size: 24px;
            font-weight: bold;
            color: #333;
            text-align: center;
        }

        .timer-display.warning {
            color: #ff9800;
            animation: timer-pulse 0.5s infinite;
        }

        .timer-display.critical {
            color: #f44336;
            animation: timer-pulse 0.3s infinite;
        }

        .timer-display.disabled {
            color: #999;
        }

        @keyframes timer-pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }

        @keyframes critical-flash {
            0%, 100% { background: white; }
            50% { background: #ffcdd2; }
        }

        .board-container {
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 30px 0;
            background: #ddd;
            padding: 10px;
            border-radius: 10px;
            position: relative;
            animation-play-state: paused;
            min-height: 400px;
            overflow: auto;
        }

        .board-container.critical-time {
            animation: critical-flash 0.3s infinite;
        }

        .board {
            display: grid;
            gap: 2px;
            background: #999;
            padding: 2px;
            position: relative;
            width: fit-content;
        }

        .square {
            background: #ccc;
            cursor: pointer;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            border: 2px solid transparent;
            transition: all 0.2s;
            user-select: none;
            -webkit-user-select: none;
            aspect-ratio: 1;
        }

        .square:hover {
            transform: scale(0.95);
        }

        .square.valid {
            background: #fff59d;
            border-color: #fbc02d;
            animation: pulse 0.6s infinite;
        }

        .square.valid-jump {
            background: #ffb74d;
            border-color: #ff9800;
            animation: pulse-jump 0.6s infinite;
        }

        .square.selected {
            background: #81c784;
            border-color: #388e3c;
        }

        .square.special-tile {
            background: linear-gradient(135deg, #ffeb3b, #fbc02d);
            position: relative;
            animation: glow 1.5s infinite alternate;
        }

        @keyframes glow {
            from {
                box-shadow: 0 0 5px rgba(255, 235, 59, 0.5);
            }
            to {
                box-shadow: 0 0 20px rgba(255, 183, 77, 0.8);
            }
        }

        .square.special-player {
            background: linear-gradient(135deg, #ff6b6b, #ff5252);
        }

        .square.special-player::before {
            content: '??;
            font-size: 20px;
            color: rgba(255, 255, 255, 0.8);
        }

        .square.special-ai {
            background: linear-gradient(135deg, #4ecdc4, #26bfa4);
        }

        .square.special-ai::before {
            content: '??;
            font-size: 20px;
            color: rgba(255, 255, 255, 0.8);
        }

        .square.special-pvp-p2 {
            background: linear-gradient(135deg, #9c27b0, #7b1fa2);
        }

        .square.special-pvp-p2::before {
            content: '??;
            font-size: 20px;
            color: rgba(255, 255, 255, 0.8);
        }

        @keyframes pulse {
            0% { box-shadow: 0 0 0 0 rgba(251, 192, 45, 0.7); }
            70% { box-shadow: 0 0 0 10px rgba(251, 192, 45, 0); }
            100% { box-shadow: 0 0 0 0 rgba(251, 192, 45, 0); }
        }

        @keyframes pulse-jump {
            0% { box-shadow: 0 0 0 0 rgba(255, 152, 0, 0.7); }
            70% { box-shadow: 0 0 0 10px rgba(255, 152, 0, 0); }
            100% { box-shadow: 0 0 0 0 rgba(255, 152, 0, 0); }
        }

        .piece {
            width: 80%;
            height: 80%;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-weight: bold;
            color: white;
            cursor: pointer;
            transition: all 0.2s;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
            z-index: 10;
            user-select: none;
            -webkit-user-select: none;
            font-size: 18px;
            position: relative;
        }

        .piece:hover {
            transform: scale(1.1);
        }

        .piece.player {
            background: linear-gradient(135deg, #ff6b6b, #ee5a5a);
        }

        .piece.ai {
            background: linear-gradient(135deg, #4ecdc4, #44a3a0);
        }

        .piece.pvp-p2 {
            background: linear-gradient(135deg, #9c27b0, #7b1fa2);
        }

        .piece.king {
            font-size: 16px;
        }

        .status-panel {
            text-align: center;
            padding: 15px;
            background: #f9f9f9;
            border-radius: 10px;
            margin-bottom: 20px;
            min-height: 60px;
        }

        .status-text {
            font-size: 18px;
            color: #333;
            margin-bottom: 10px;
            font-weight: bold;
        }

        .current-player-indicator {
            font-size: 14px;
            color: #666;
            margin-top: 5px;
            padding: 8px;
            background: rgba(0, 0, 0, 0.05);
            border-radius: 4px;
        }

        .current-player-name {
            font-weight: bold;
            font-size: 16px;
        }

        .current-player-name.player1 {
            color: #ff6b6b;
        }

        .current-player-name.player2 {
            color: #9c27b0;
        }

        .status-text.waiting {
            color: #ff9800;
        }

        .status-text.jumping {
            color: #f44336;
        }

        .status-text.thinking {
            color: #2196f3;
        }

        .status-text.winner {
            color: #4caf50;
            font-size: 24px;
            animation: bounce 0.6s infinite;
        }

        .status-text.loser {
            color: #f44336;
            font-size: 24px;
        }

        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }

        .button-group {
            display: flex;
            gap: 10px;
            justify-content: center;
            flex-wrap: wrap;
        }

        button {
            padding: 12px 30px;
            font-size: 16px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s;
            font-weight: bold;
            user-select: none;
            -webkit-user-select: none;
        }

        .btn-reset {
            background: #667eea;
            color: white;
        }

        .btn-reset:hover {
            background: #5568d3;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }

        .btn-reset:disabled {
            background: #ccc;
            cursor: not-allowed;
            transform: none;
        }

        .btn-end-jump {
            background: #ff9800;
            color: white;
            padding: 10px 20px;
            font-size: 14px;
        }

        .btn-end-jump:hover {
            background: #f57c00;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(255, 152, 0, 0.4);
        }

        .btn-end-jump:disabled {
            background: #ccc;
            cursor: not-allowed;
            transform: none;
        }

        .btn-menu {
            background: #666;
            color: white;
            padding: 10px 20px;
            font-size: 14px;
        }

        .btn-menu:hover {
            background: #555;
            transform: translateY(-2px);
        }

        .legend {
            display: flex;
            gap: 20px;
            justify-content: center;
            margin-top: 15px;
            font-size: 13px;
            color: #555;
        }

        .legend-item {
            display: flex;
            alignItems: center;
            gap: 5px;
        }

        .legend-color {
            width: 20px;
            height: 20px;
            border-radius: 4px;
            border: 2px solid;
        }

        .legend-color.move {
            background: #fff59d;
            border-color: #fbc02d;
        }

        .legend-color.jump {
            background: #ffb74d;
            border-color: #ff9800;
        }

        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

        .modal.show {
            display: flex;
        }

        .modal-content {
            background: white;
            padding: 30px;
            border-radius: 15px;
            max-width: 500px;
            width: 90%;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        }

        .modal-content h2 {
            color: #333;
            margin-bottom: 20px;
            text-align: center;
        }

        .modal-content p {
            color: #666;
            margin-bottom: 15px;
            line-height: 1.6;
        }

        .modal-content .share-link {
            background: #f5f5f5;
            padding: 12px;
            border-radius: 8px;
            font-family: monospace;
            font-size: 12px;
            color: #333;
            margin: 15px 0;
            word-break: break-all;
            border: 1px solid #ddd;
        }

        .modal-buttons {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }

        .modal-buttons button {
            flex: 1;
            padding: 12px;
            font-size: 16px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s;
        }

        .modal-buttons .btn-copy {
            background: #667eea;
            color: white;
        }

        .modal-buttons .btn-copy:hover {
            background: #5568d3;
        }

        .modal-buttons .btn-close {
            background: #ccc;
            color: #333;
        }

        .modal-buttons .btn-close:hover {
            background: #bbb;
        }

        .board-info {
            text-align: center;
            font-size: 12px;
            color: #666;
            margin-top: 10px;
        }
        
        /* ?啣??郎靽??*/
        
        /* 璉?頝唾???畾蔣?寞? */
        .piece-trail {
            position: absolute;
            width: 80%;
            height: 80%;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-weight: bold;
            color: white;
            z-index: 5;
            opacity: 0.6;
            animation: fadeOut 0.3s forwards;
        }
        
        @keyframes fadeOut {
            0% { opacity: 0.6; transform: scale(1); }
            100% { opacity: 0; transform: scale(0.5); }
        }
        
        /* 璉?頝唾?蝘餃?????*/
        .piece-jumping {
            animation: jumpMove 0.3s ease-in-out forwards;
        }
        
        @keyframes jumpMove {
            0% { transform: translate(0, 0) scale(1); }
            30% { transform: translate(var(--tx), var(--ty)) scale(1.1); }
            70% { transform: translate(var(--tx), var(--ty)) scale(1.1); }
            100% { transform: translate(var(--tx), var(--ty)) scale(1); }
        }
        
        /* 璉?鋡急瘥???寞? */
        .piece-destroyed {
            position: absolute;
            width: 80%;
            height: 80%;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-weight: bold;
            color: white;
            z-index: 16;
            animation: splitPiece 0.5s ease-out forwards;
        }
        
        @keyframes splitPiece {
            0% { transform: translateY(0) rotate(0deg); opacity: 1; }
            50% { transform: translateY(-10px) rotate(10deg); opacity: 0.7; }
            100% { transform: translateY(-30px) rotate(20deg); opacity: 0; }
        }
        
        /* 璉?鋡怠??脩??寞? */
        .piece-cut {
            position: absolute;
            width: 80%;
            height: 80%;
            border-radius: 50%;
            z-index: 16;
            animation: cutPiece 0.5s ease-out forwards;
        }
        
        .piece-cut-part {
            position: absolute;
            width: 40%;
            height: 40%;
            border-radius: 50%;
            z-index: 16;
        }
        
        @keyframes cutPiece {
            0% { opacity: 1; transform: scale(1); }
            100% { opacity: 0; transform: scale(0.5); }
        }
        
        /* ????*/
        .sword-effect {
            position: absolute;
            width: 100%;
            height: 100%;
            background: linear-gradient(45deg, transparent 45%, yellow, transparent 55%);
            opacity: 0.8;
            z-index: 15;
            animation: swordSlash 0.3s ease-out forwards;
        }
        
        @keyframes swordSlash {
            0% { transform: rotate(0deg) scaleX(0); opacity: 0.8; }
            50% { transform: rotate(10deg) scaleX(1.2); opacity: 1; }
            100% { transform: rotate(20deg) scaleX(1); opacity: 0; }
        }
        
        /* ??蝎??寞? */
        .star-particle {
            position: absolute;
            width: 4px;
            height: 4px;
            background-color: gold;
            border-radius: 50%;
            pointer-events: none;
            z-index: 5;
            animation: float 3s ease-in-out infinite;
        }

        @keyframes float {
            0% {
                transform: translateY(0) rotate(0deg);
                opacity: 1;
            }
            50% {
                transform: translateY(-10px) rotate(180deg);
                opacity: 0.8;
            }
            100% {
                transform: translateY(0) rotate(360deg);
                opacity: 1;
            }
        }
        
        /* ???寞? */
        .soul-effect {
            position: absolute;
            width: 20px;
            height: 20px;
            background-color: lightblue;
            border-radius: 50%;
            z-index: 17;
            animation: soulRise 1s ease-out forwards;
        }
        
        @keyframes soulRise {
            0% { transform: translateY(0) scale(1); opacity: 1; }
            100% { transform: translateY(-50px) scale(0.5); opacity: 0; }
        }
    </style>
</head>
<body>
